# Copy to .env and fill in only the services you actually have.
# Local mode (python learn.py && python spartanbot.py) needs none of these.

# Slack Socket Mode is the supported way to run the bot in a workspace.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Optional. When unset, the bot calls auth.test.
SLACK_BOT_ID=
SLACK_BOT_NAME=testonebot
# Original channel name, typo included.
SLACK_CHANNEL=#testonebotchanel

# Leave MONGODB_URI unset to use data/knowledge.json.
MONGODB_URI=
MONGODB_DB=

# Twilio SMS allow-list. The sender must occur inside this string.
user_number=
twilio_number=

# Google Custom Search JSON API. Leave unset and those hits are skipped.
my_api_key=
my_cse_id=

# Retired IBM Watson Natural Language Classifier. Calls fail closed.
bluemix_username=
bluemix_password=
WATSON_CLASSIFIER_ID=

# Alexa Lambda backend. Defaults to the 2017 Heroku app.
ALEXA_BACKEND_URL=http://127.0.0.1:6000/alexa_endpoint/
